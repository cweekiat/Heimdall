# Edge for hosted Heimdall (task 063, ADR-009). TLS ends at Cloudflare; the tunnel (cloudflared)
# reaches this on the internal network only. Python serves /api; Caddy serves the UI and the
# basemap tiles after asking the app whether the session is valid (forward_auth).
{
	admin off
	auto_https off
	servers {
		trusted_proxies static private_ranges
		client_ip_headers Cf-Connecting-Ip X-Forwarded-For
	}
}

:8080 {
	encode zstd gzip
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		# Same policy as heimdall.api.app.csp_for("openfreemap"); a test keeps them equal.
		?Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://tiles.openfreemap.org https://tiles.maps.eox.at https://geo.vliz.be https://tiles.openseamap.org; img-src 'self' data: blob: https://tiles.openfreemap.org https://tiles.maps.eox.at https://geo.vliz.be https://tiles.openseamap.org; font-src 'self' data: https://tiles.openfreemap.org https://tiles.maps.eox.at https://geo.vliz.be https://tiles.openseamap.org; connect-src 'self' https://tiles.openfreemap.org https://tiles.maps.eox.at https://geo.vliz.be https://tiles.openseamap.org; worker-src 'self' blob:; child-src blob:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
	}
	request_body {
		max_size 2MB
	}

	# Sign-in page: static, no session needed.
	@login path /login.html /login.js /login.css
	handle @login {
		root * /srv/web
		header Cache-Control "no-cache"
		file_server
	}

	# API (and the generated basemap style) are answered by the app, which gates them itself.
	@app path /api/* /basemap/style.json
	handle @app {
		reverse_proxy heimdall:8000 {
			flush_interval -1 # server-sent events
			transport http {
				read_timeout 0
			}
		}
	}

	# Basemap tiles, fonts and sprites: large files with range requests, served by Caddy.
	handle_path /basemap/* {
		forward_auth heimdall:8000 {
			uri /api/auth/check
		}
		root * /srv/basemap
		header Cache-Control "private, max-age=86400"
		file_server
	}

	# The app shell. Hashed assets never change; index.html must always be revalidated.
	handle {
		forward_auth heimdall:8000 {
			uri /api/auth/check
		}
		root * /srv/web
		@hashed path /assets/*
		header @hashed Cache-Control "private, max-age=31536000, immutable"
		header / Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
