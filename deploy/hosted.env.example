# Template for /srv/heimdall/hosted.env on each VM (task 065). Copy, fill in, then:
#   sudo install -m 600 -o heimdall-runner -g heimdall-runner hosted.env /srv/heimdall/hosted.env
# Never commit the filled-in file. Image tags are set by deploy/scripts/deploy.sh, not here.

# dev on the dev VM, prod on the prod VM (selects config/env/<name>.yaml)
HEIMDALL_ENV=prod
# Public hostname(s) Cloudflare sends to this VM (comma list)
HEIMDALL_ALLOWED_HOSTS=heimdall.example.org
# Host directory with lake, DuckDB files, basemap/, ref/, replay/, secrets/ (owned by uid 10001)
HEIMDALL_DATA=/srv/heimdall/data
# Cloudflare Tunnel token for THIS VM's tunnel (Zero Trust > Networks > Tunnels)
TUNNEL_TOKEN=
# Resource limits for the app container. prod VM (3 OCPU / 18 GB): 12g / 2.5. dev VM (1 OCPU / 6 GB): 4g / 0.9
HEIMDALL_MEM=12g
HEIMDALL_CPUS=2.5
# prod only, optional: also run the local model for shift briefs (internal network, no egress)
# COMPOSE_PROFILES=llm
